// Template: the build scripts write a copy with the three FILE_* names set.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    NOLFVR_VER_MAJOR,NOLFVR_VER_MINOR,NOLFVR_VER_PATCH,NOLFVR_VER_BUILD
 PRODUCTVERSION NOLFVR_VER_MAJOR,NOLFVR_VER_MINOR,NOLFVR_VER_PATCH,NOLFVR_VER_BUILD
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       @FILE_TYPE@
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      NOLFVR_COMPANY
            VALUE "FileDescription",  "@FILE_DESC@"
            VALUE "FileVersion",      NOLFVR_VER_STRING
            VALUE "InternalName",     "@FILE_NAME@"
            VALUE "LegalCopyright",   NOLFVR_COPYRIGHT
            VALUE "OriginalFilename", "@FILE_NAME@"
            VALUE "ProductName",      NOLFVR_PRODUCT
            VALUE "ProductVersion",   NOLFVR_VER_STRING
            VALUE "Comments",         NOLFVR_COMMENTS
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
